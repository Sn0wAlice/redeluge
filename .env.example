# Copy to .env before the first `docker compose up`.

# Web UI password. Required: without it the image would keep Deluge's default
# password "deluge".
DELUGE_WEB_PASSWORD=change-me

# Set to 1 for a single run to overwrite a password changed in the UI.
#DELUGE_WEB_PASSWORD_RESET=0

# Ownership of /config and /downloads on the host.
PUID=1000
PGID=1000

# Tags the built image: redeluge's own version, the one in Cargo.toml. The
# version the daemon reports to clients is a different number and is fixed at
# 2.2.1, because that is the Deluge they know how to speak.
REDELUGE_VERSION=1.3.1
